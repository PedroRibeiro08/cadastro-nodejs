<%- include("../partials/header", { titulo }) %>

<div class="titulo-pagina">
  <div>
    <h1>Produtos</h1>
    <p>Lista de produtos cadastrados.</p>
  </div>
  <a href="/produtos/cadastro" class="botao">Novo produto</a>
</div>

<% if (produtos.length === 0) { %>
  <div class="vazio">Ainda não existem produtos cadastrados.</div>
<% } else { %>
  <div class="tabela">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome</th>
          <th>Descrição</th>
          <th>Preço</th>
          <th>Estoque</th>
          <th>Categoria</th>
        </tr>
      </thead>
      <tbody>
        <% produtos.forEach(produto => { %>
          <tr>
            <td><%= produto.id %></td>
            <td><%= produto.nome %></td>
            <td><%= produto.descricao %></td>
            <td>R$ <%= Number(produto.preco).toFixed(2).replace(".", ",") %></td>
            <td><%= produto.estoque %></td>
            <td><%= produto.categoria %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("../partials/footer") %>