<%- include("../partials/header", { titulo }) %>

<div class="titulo-pagina">
  <div>
    <h1>Clientes</h1>
    <p>Lista de clientes cadastrados.</p>
  </div>
  <a href="/clientes/cadastro" class="botao">Novo cliente</a>
</div>

<% if (clientes.length === 0) { %>
  <div class="vazio">Ainda não existem clientes cadastrados.</div>
<% } else { %>
  <div class="tabela">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome</th>
          <th>E-mail</th>
          <th>Telefone</th>
          <th>Cidade</th>
        </tr>
      </thead>
      <tbody>
        <% clientes.forEach(cliente => { %>
          <tr>
            <td><%= cliente.id %></td>
            <td><%= cliente.nome %></td>
            <td><%= cliente.email %></td>
            <td><%= cliente.telefone %></td>
            <td><%= cliente.cidade %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("../partials/footer") %>